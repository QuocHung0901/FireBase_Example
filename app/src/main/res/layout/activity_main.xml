<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="14dp">

    <!-- ====================================== -->
    <!-- TITLE -->
    <!-- ====================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ARTICLE MANAGEMENT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"/>

    <!-- ====================================== -->
    <!-- ARTICLE ID -->
    <!-- ====================================== -->

    <EditText
        android:id="@+id/edtArticleId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Article ID - VD: A002"
        android:inputType="text"
        android:padding="10dp"/>

    <!-- ====================================== -->
    <!-- TITLE -->
    <!-- ====================================== -->

    <EditText
        android:id="@+id/edtArticleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tiêu đề bài viết"
        android:inputType="text"
        android:padding="10dp"/>

    <!-- ====================================== -->
    <!-- CONTENT -->
    <!-- ====================================== -->

    <EditText
        android:id="@+id/edtArticleContent"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Nội dung bài viết"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:padding="10dp"/>

    <!-- ====================================== -->
    <!-- CHỌN ẢNH -->
    <!-- ====================================== -->

    <Button
        android:id="@+id/btnChooseImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHỌN ẢNH"
        android:layout_marginTop="8dp"/>

    <!-- ====================================== -->
    <!-- PREVIEW -->
    <!-- ====================================== -->

    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="Article image"
        android:visibility="gone"/>

    <!-- ====================================== -->
    <!-- SAVE -->
    <!-- ====================================== -->

    <Button
        android:id="@+id/btnSaveArticle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LƯU BÀI VIẾT LÊN FIREBASE"
        android:layout_marginTop="10dp"/>

    <ProgressBar
        android:id="@+id/progressMain"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- ====================================== -->
    <!-- ARTICLE LIST -->
    <!-- ====================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH BÀI VIẾT"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingTop="12dp"
        android:paddingBottom="5dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerArticles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"/>

  </LinearLayout>

</androidx.core.widget.NestedScrollView>